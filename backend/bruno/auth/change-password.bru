meta {
  name: Change Password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "currentPassword": "oldPassword123",
    "newPassword": "newPassword123"
  }
}

script:post-response {
  if (res.status === 200 && res.body?.token) {
    bru.setVar("token", res.body.token);
  }
}

docs {
  # Change Password
  Updates the password for the authenticated admin user and issues a refreshed JWT token.

  ### Authentication
  - **Bearer Token** required (`Authorization: Bearer <token>`).

  ### Request Body (`application/json`)
  - `currentPassword` (string, required): The user's existing password.
  - `newPassword` (string, required): New password (minimum **8 characters**, must differ from `currentPassword`).

  ### Responses
  - `200 OK`: `{ token, user }`
  - `400 Bad Request`: Missing fields, new password shorter than 8 characters, or identical to the current password.
  - `401 Unauthorized`: Invalid token or incorrect `currentPassword`.
  - `404 Not Found`: User not found.
  - `500 Internal Server Error`: Unexpected error while changing password.
}