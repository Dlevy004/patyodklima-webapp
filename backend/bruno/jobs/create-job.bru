meta {
  name: Create Job
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/jobs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "client_id": "{{clientId}}",
    "category": "installation",
    "ac_unit": "Gree Comfort Pro 3.5 kW",
    "job_date": "2026-12-05",
    "labor_fee": 45000,
    "total_amount": 285000,
    "general_notes": "Nappali oldalfali split klíma szerelése",
    "internal_notes": "Faláttörés szükséges",
    "is_completed": false
  }
}

script:post-response {
  const createdId = res.body?.id ?? res.body?.[0]?.id;
  if (res.status === 201 && createdId) {
    bru.setVar("jobId", createdId);
  }
}

docs {
  # Create Job
  Creates a new job/work order record by forwarding the request payload to `jobService.createJob`.

  ### Authentication
  - **Bearer Token** required (`Authorization: Bearer <token>`).

  ### Request Body (`application/json`)
  - Job fields expected by `jobService.createJob`: `client_id`, `category` (`"survey"` | `"installation"` | `"maintenance"` | `"cleaning"`), `ac_unit`, `job_date` (required, `YYYY-MM-DD`), `labor_fee`, `total_amount` (required, integer), `general_notes`, `internal_notes`, and `is_completed` (boolean).

  ### Responses
  - `201 Created`: Returns the newly created job object.
  - `400 Bad Request`: Validation or database insertion error (`{ "message": "Hiba történt a munka létrehozása során." }`).
  - `401 Unauthorized`: Missing or invalid JWT token.
}