meta {
  name: Get Reference By ID
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/references/:id
  body: none
  auth: bearer
}

params:path {
  id: {{referenceId}}
}

auth:bearer {
  token: {{token}}
}

docs {
  # Get Reference By ID
  Retrieves a single reference image record matching the provided path parameter `id`.

  ### Authentication
  - **Bearer Token** required (`Authorization: Bearer <token>`).

  ### Path Parameters
  - `id` (string | number, required): Unique identifier of the reference image.

  ### Responses
  - `200 OK`: Returns the matching reference object.
  - `401 Unauthorized`: Missing or invalid JWT token.
  - `404 Not Found`: Reference image not found (`{ "message": "A referenciakép nem található." }`).
  - `500 Internal Server Error`: Unexpected error while fetching the reference (`{ "message": "Hiba történt a referenciakép lekérése közben." }`).
}