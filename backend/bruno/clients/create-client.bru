meta {
  name: Create Client
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/clients
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Kovács János",
    "email": "kovacs.janos@example.com",
    "phone": "+36301234567",
    "address": "4765 Csenger, Fő utca 12.",
    "notes": "3.5 kW-os split klíma telepítés"
  }
}

script:post-response {
  const createdId = res.body?.id ?? res.body?.[0]?.id;
  if (res.status === 201 && createdId) {
    bru.setVar("clientId", createdId);
  }
}

docs {
  # Create Client
  Creates a new client record by forwarding the request payload to `clientService.createClient`.

  ### Authentication
  - **Bearer Token** required (`Authorization: Bearer <token>`).

  ### Request Body (`application/json`)
  - Client fields expected by the database schema (e.g., `name`, `email`, `phone`, `address`, `notes`).

  ### Responses
  - `201 Created`: Returns the newly created client object.
  - `400 Bad Request`: Validation or database insertion error (`{ "message": "Hiba történt az ügyfél létrehozása során." }`).
  - `401 Unauthorized`: Missing or invalid JWT token.
}